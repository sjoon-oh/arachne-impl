+// InnerProductSpaceHalf: mirrors InnerProductSpace (float) above exactly,
+// including its "distance" = 1 - dot convention -- half data is widened to
+// float via F16C (VCVTPH2PS) first, then it's the same math. Same 16-wide
+// outer chunk contract and F16C-tier/AVX512-tier reasoning as
+// L2SpaceHalf in space_l2.h.
+static float
+InnerProductHalf(const void *pVect1v, const void *pVect2v, const void *qty_ptr) {
+    const uint16_t *pVect1 = (const uint16_t *) pVect1v;
+    const uint16_t *pVect2 = (const uint16_t *) pVect2v;
+    size_t qty = *((size_t *) qty_ptr);
+
+    float res = 0;
+    for (size_t i = 0; i < qty; i++) {
+        res += HalfToFloat(pVect1[i]) * HalfToFloat(pVect2[i]);
+    }
+    return res;
+}
+
+static float
+InnerProductDistanceHalf(const void *pVect1v, const void *pVect2v, const void *qty_ptr) {
+    return 1.0f - InnerProductHalf(pVect1v, pVect2v, qty_ptr);
+}
+
+#if defined(USE_F16C)
+static float
+InnerProductHalfSIMD16ExtF16C(const void *pVect1v, const void *pVect2v, const void *qty_ptr) {
+    const uint16_t *pVect1 = (const uint16_t *) pVect1v;
+    const uint16_t *pVect2 = (const uint16_t *) pVect2v;
+    size_t qty = *((size_t *) qty_ptr);
+    size_t qty16 = qty >> 4;
+    float PORTABLE_ALIGN32 TmpRes[8];
+
+    __m256 sum = _mm256_set1_ps(0);
+    for (size_t i = 0; i < qty16; i++) {
+        for (int j = 0; j < 2; j++) {
+            __m128i h1 = _mm_loadu_si128((const __m128i *) pVect1);
+            __m128i h2 = _mm_loadu_si128((const __m128i *) pVect2);
+            pVect1 += 8;
+            pVect2 += 8;
+            __m256 v1 = _mm256_cvtph_ps(h1);
+            __m256 v2 = _mm256_cvtph_ps(h2);
+            sum = _mm256_add_ps(sum, _mm256_mul_ps(v1, v2));
+        }
+    }
+
+    _mm256_store_ps(TmpRes, sum);
+    return TmpRes[0] + TmpRes[1] + TmpRes[2] + TmpRes[3] + TmpRes[4] + TmpRes[5] + TmpRes[6] + TmpRes[7];
+}
+#endif
+
+#if defined(USE_AVX512) && defined(__F16C__)
+static float
+InnerProductHalfSIMD16ExtAVX512(const void *pVect1v, const void *pVect2v, const void *qty_ptr) {
+    const uint16_t *pVect1 = (const uint16_t *) pVect1v;
+    const uint16_t *pVect2 = (const uint16_t *) pVect2v;
+    size_t qty = *((size_t *) qty_ptr);
+    size_t qty16 = qty >> 4;
+
+    __m512 sum = _mm512_set1_ps(0);
+    for (size_t i = 0; i < qty16; i++) {
+        __m256i h1 = _mm256_loadu_si256((const __m256i *) pVect1);
+        __m256i h2 = _mm256_loadu_si256((const __m256i *) pVect2);
+        pVect1 += 16;
+        pVect2 += 16;
+        __m512 v1 = _mm512_cvtph_ps(h1);
+        __m512 v2 = _mm512_cvtph_ps(h2);
+        sum = _mm512_add_ps(sum, _mm512_mul_ps(v1, v2));
+    }
+    return _mm512_reduce_add_ps(sum);
+}
+#endif
+
+#if defined(USE_F16C)
+static DISTFUNC<float> InnerProductHalfSIMD16Ext = InnerProductHalfSIMD16ExtF16C;
+
+static float
+InnerProductDistanceHalfSIMD16Ext(const void *pVect1v, const void *pVect2v, const void *qty_ptr) {
+    return 1.0f - InnerProductHalfSIMD16Ext(pVect1v, pVect2v, qty_ptr);
+}
+
+static float
+InnerProductDistanceHalfSIMD16ExtResiduals(const void *pVect1v, const void *pVect2v, const void *qty_ptr) {
+    size_t qty = *((size_t *) qty_ptr);
+    size_t qty16 = qty >> 4 << 4;
+    float res = InnerProductHalfSIMD16Ext(pVect1v, pVect2v, &qty16);
+
+    const uint16_t *pVect1 = (const uint16_t *) pVect1v + qty16;
+    const uint16_t *pVect2 = (const uint16_t *) pVect2v + qty16;
+    size_t qty_left = qty - qty16;
+    float res_tail = InnerProductHalf(pVect1, pVect2, &qty_left);
+    return 1.0f - (res + res_tail);
+}
+#endif
