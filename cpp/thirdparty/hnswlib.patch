diff --git a/hnswlib/half_utils.h b/hnswlib/half_utils.h
new file mode 100644
index 0000000..aacf1c7
--- /dev/null
+++ b/hnswlib/half_utils.h
@@ -0,0 +1,80 @@
+#pragma once
+#include <cstdint>
+#include <cstring>
+
+// Portable (no SIMD, no compiler _Float16 extension) IEEE-754 binary16 <->
+// binary32 conversion. Used two ways by space_l2.h/space_ip.h's *Half
+// spaces:
+//   - as the unconditional scalar fstdistfunc_ fallback when no SIMD ISA
+//     is compiled in at all;
+//   - as the residual/tail handler after a SIMD chunk loop, exactly like
+//     L2Sqr/InnerProduct already serve that role for the float spaces.
+//
+// Storage type for a half value is a raw uint16_t (the IEEE-754 binary16
+// bit pattern), not a compiler-specific `_Float16`/`__fp16` type -- kept
+// portable across toolchains, and it's what the F16C conversion intrinsics
+// (_mm*_cvtph_ps) operate on too (a packed-uint16 __m128i/__m256i input).
+
+namespace hnswlib {
+
+inline float HalfToFloat(uint16_t h) {
+    uint32_t sign = static_cast<uint32_t>(h & 0x8000u) << 16;
+    uint32_t exp = (h >> 10) & 0x1Fu;
+    uint32_t mant = h & 0x3FFu;
+    uint32_t bits;
+
+    if (exp == 0) {
+        if (mant == 0) {
+            bits = sign;  // +/-0
+        } else {
+            // Subnormal half -> normalize into a normal float.
+            exp = 1;
+            while ((mant & 0x400u) == 0) {
+                mant <<= 1;
+                exp--;
+            }
+            mant &= 0x3FFu;
+            bits = sign | ((exp + (127 - 15)) << 23) | (mant << 13);
+        }
+    } else if (exp == 0x1Fu) {
+        bits = sign | 0x7F800000u | (mant << 13);  // inf / NaN
+    } else {
+        bits = sign | ((exp + (127 - 15)) << 23) | (mant << 13);
+    }
+
+    float f;
+    std::memcpy(&f, &bits, sizeof(f));
+    return f;
+}
+
+// Encoder is only needed by tests/tooling that construct half data from
+// float -- no space in space_l2.h/space_ip.h calls this, since Arachne's
+// own quantization step (future work, outside this submodule) is
+// responsible for producing the binary16 bytes hnswlib stores and reads
+// via HalfToFloat above. Subnormal results are flushed to zero rather than
+// encoded exactly: acceptable for that use (test-data generation), not
+// intended as a general-purpose codec.
+inline uint16_t FloatToHalf(float f) {
+    uint32_t bits;
+    std::memcpy(&bits, &f, sizeof(bits));
+
+    uint32_t sign = (bits >> 16) & 0x8000u;
+    uint32_t f_exp = (bits >> 23) & 0xFFu;
+    uint32_t mant = bits & 0x7FFFFFu;
+
+    if (f_exp == 0xFFu) {
+        // inf / NaN
+        return static_cast<uint16_t>(sign | 0x7C00u | (mant ? 0x200u : 0u));
+    }
+
+    int32_t exp = static_cast<int32_t>(f_exp) - 127 + 15;
+    if (exp <= 0) {
+        return static_cast<uint16_t>(sign);  // underflow -> +/-0
+    }
+    if (exp >= 0x1F) {
+        return static_cast<uint16_t>(sign | 0x7C00u);  // overflow -> +/-inf
+    }
+    return static_cast<uint16_t>(sign | (exp << 10) | (mant >> 13));
+}
+
+}  // namespace hnswlib
