+// F16C: float16<->float32 hardware conversion (VCVTPH2PS/VCVTPS2PH). A
+// separate CPUID feature from AVX/AVX512 -- checked independently rather
+// than assumed, even though in practice it has shipped alongside AVX since
+// Ivy Bridge. Backs the SIMD tiers of L2SpaceHalf/InnerProductSpaceHalf
+// (space_l2.h/space_ip.h); their scalar fallback (half_utils.h) doesn't
+// need this and works regardless.
+#ifndef NO_MANUAL_VECTORIZATION
+#if defined(USE_AVX) && defined(__F16C__)
+#define USE_F16C
+#endif
+#endif
+
+// The uint8/int8 SIMD tiers (L2SpaceI/L2SpaceInt8/InnerProductSpaceU8/
+// InnerProductSpaceInt8 in space_l2.h/space_ip.h) widen bytes to 32-bit
+// lanes via PMOVZXBD/PMOVSXBD-family instructions before doing arithmetic,
+// to sidestep 8/16-bit overflow entirely rather than reason about
+// saturation. Those instructions need SSE4.1, not just baseline SSE/SSE2 --
+// and their 256-bit form needs true AVX2, not just AVX1 (AVX1 has no
+// integer ymm ops at all). USE_SSE/USE_AVX above don't guarantee either,
+// so they're checked as their own capability, same reasoning as USE_F16C.
+#ifndef NO_MANUAL_VECTORIZATION
+#if defined(USE_SSE) && defined(__SSE4_1__)
+#define USE_SSE41
+#endif
+#if defined(USE_AVX) && defined(__AVX2__)
+#define USE_AVX2
+#endif
+#endif
+
 #if defined(USE_AVX) || defined(USE_SSE)
 #ifdef _MSC_VER
 #include <intrin.h>
@@ -114,6 +143,40 @@ static bool AVX512Capable() {
     }
     return HW_AVX512F && avx512Supported;
 }
+
+// AVXCapable() only checks CPUID.1:ECX.AVX[bit 28] -- true on any
+// Sandy/Ivy Bridge-class CPU, which may not have AVX2 (CPUID.(7,0):EBX.
+// AVX2[bit 5], a separate/later feature). USE_AVX alone is therefore not
+// sufficient to safely dispatch to the 256-bit *integer* SIMD tiers added
+// for L2SpaceI/L2SpaceInt8/InnerProductSpaceU8/InnerProductSpaceInt8 in
+// space_l2.h/space_ip.h (AVX1 has no integer ymm ops at all) -- this is
+// their runtime guard, same role AVXCapable()/AVX512Capable() play above.
+static bool AVX2Capable() {
+    if (!AVXCapable()) return false;
+
+    int cpuInfo[4];
+    cpuid(cpuInfo, 0, 0);
+    int nIds = cpuInfo[0];
+
+    bool HW_AVX2 = false;
+    if (nIds >= 0x00000007) {
+        cpuid(cpuInfo, 0x00000007, 0);
+        HW_AVX2 = (cpuInfo[1] & ((int)1 << 5)) != 0;  // CPUID.(7,0):EBX.AVX2
+    }
+    return HW_AVX2;
+}
+
+// F16C (VCVTPH2PS/VCVTPS2PH, CPUID.1:ECX.F16C[bit 29]) is its own CPUID
+// feature, independent of AVX2/AVX512F -- checked at runtime the same way,
+// backing L2SpaceHalf/InnerProductSpaceHalf's SIMD tiers in space_l2.h/
+// space_ip.h.
+static bool F16CCapable() {
+    if (!AVXCapable()) return false;
+
+    int cpuInfo[4];
+    cpuid(cpuInfo, 1, 0);
+    return (cpuInfo[2] & ((int)1 << 29)) != 0;  // CPUID.1:ECX.F16C
+}
 #endif
 
 #include <queue>
diff --git a/hnswlib/space_ip.h b/hnswlib/space_ip.h
index 0e6834c..14030df 100644
--- a/hnswlib/space_ip.h
+++ b/hnswlib/space_ip.h
@@ -1,5 +1,9 @@
 #pragma once
 #include "hnswlib.h"
+#include "half_utils.h"
+
+#include <cstdint>
+#include <cstring>
 
 namespace hnswlib {
 
@@ -397,4 +401,476 @@ class InnerProductSpace : public SpaceInterface<float> {
 ~InnerProductSpace() {}
 };
 
+// InnerProductSpaceU8/InnerProductSpaceInt8: uint8/int8 dot product,
+// widened to int32 lanes first (same reasoning as L2SpaceI/L2SpaceInt8 in
+// space_l2.h -- sidesteps 8/16-bit overflow entirely rather than reason
+// about saturation). SpaceInterface<int>, matching L2SpaceI's convention
+// for integer-typed spaces.
+//
+// "Distance" here is -dot, not 1-dot: unlike float cosine, a raw integer
+// dot product has no natural upper bound to subtract from, so the usual
+// max-inner-product-search-as-min-search transformation (negate, since
+// hnswlib's graph search always minimizes) is used instead.
+static int
+InnerProductU8(const void *__restrict pVect1v, const void *__restrict pVect2v, const void *__restrict qty_ptr) {
+    const unsigned char *pVect1 = (const unsigned char *) pVect1v;
+    const unsigned char *pVect2 = (const unsigned char *) pVect2v;
+    size_t qty = *((size_t *) qty_ptr);
+
+    int res = 0;
+    for (size_t i = 0; i < qty; i++) {
+        res += (int) pVect1[i] * (int) pVect2[i];
+    }
+    return res;
+}
+
+static int
+InnerProductDistanceU8(const void *pVect1v, const void *pVect2v, const void *qty_ptr) {
+    return -InnerProductU8(pVect1v, pVect2v, qty_ptr);
+}
+
+#if defined(USE_SSE41)
+static int
+InnerProductU8SIMD16ExtSSE41(const void *__restrict pVect1v, const void *__restrict pVect2v,
+        const void *__restrict qty_ptr) {
+    const unsigned char *pVect1 = (const unsigned char *) pVect1v;
+    const unsigned char *pVect2 = (const unsigned char *) pVect2v;
+    size_t qty = *((size_t *) qty_ptr);
+    size_t qty16 = qty >> 4;
+
+    __m128i sum = _mm_setzero_si128();
+    for (size_t i = 0; i < qty16; i++) {
+        for (int j = 0; j < 4; j++) {
+            int32_t a4, b4;
+            std::memcpy(&a4, pVect1, 4);
+            std::memcpy(&b4, pVect2, 4);
+            pVect1 += 4;
+            pVect2 += 4;
+            __m128i a32 = _mm_cvtepu8_epi32(_mm_cvtsi32_si128(a4));
+            __m128i b32 = _mm_cvtepu8_epi32(_mm_cvtsi32_si128(b4));
+            sum = _mm_add_epi32(sum, _mm_mullo_epi32(a32, b32));
+        }
+    }
+
+    int32_t PORTABLE_ALIGN32 tmp[4];
+    _mm_store_si128((__m128i *) tmp, sum);
+    return tmp[0] + tmp[1] + tmp[2] + tmp[3];
+}
+#endif
+
+#if defined(USE_AVX2)
+static int
+InnerProductU8SIMD16ExtAVX2(const void *__restrict pVect1v, const void *__restrict pVect2v,
+        const void *__restrict qty_ptr) {
+    const unsigned char *pVect1 = (const unsigned char *) pVect1v;
+    const unsigned char *pVect2 = (const unsigned char *) pVect2v;
+    size_t qty = *((size_t *) qty_ptr);
+    size_t qty16 = qty >> 4;
+
+    __m256i sum = _mm256_setzero_si256();
+    for (size_t i = 0; i < qty16; i++) {
+        for (int j = 0; j < 2; j++) {
+            __m128i a8 = _mm_loadl_epi64((const __m128i *) pVect1);
+            __m128i b8 = _mm_loadl_epi64((const __m128i *) pVect2);
+            pVect1 += 8;
+            pVect2 += 8;
+            __m256i a32 = _mm256_cvtepu8_epi32(a8);
+            __m256i b32 = _mm256_cvtepu8_epi32(b8);
+            sum = _mm256_add_epi32(sum, _mm256_mullo_epi32(a32, b32));
+        }
+    }
+
+    int32_t PORTABLE_ALIGN32 tmp[8];
+    _mm256_storeu_si256((__m256i *) tmp, sum);
+    return tmp[0] + tmp[1] + tmp[2] + tmp[3] + tmp[4] + tmp[5] + tmp[6] + tmp[7];
+}
+#endif
+
+#if defined(USE_AVX512)
+static int
+InnerProductU8SIMD16ExtAVX512(const void *__restrict pVect1v, const void *__restrict pVect2v,
+        const void *__restrict qty_ptr) {
+    const unsigned char *pVect1 = (const unsigned char *) pVect1v;
+    const unsigned char *pVect2 = (const unsigned char *) pVect2v;
+    size_t qty = *((size_t *) qty_ptr);
+    size_t qty16 = qty >> 4;
+
+    __m512i sum = _mm512_setzero_si512();
+    for (size_t i = 0; i < qty16; i++) {
+        __m128i a8 = _mm_loadu_si128((const __m128i *) pVect1);
+        __m128i b8 = _mm_loadu_si128((const __m128i *) pVect2);
+        pVect1 += 16;
+        pVect2 += 16;
+        __m512i a32 = _mm512_cvtepu8_epi32(a8);
+        __m512i b32 = _mm512_cvtepu8_epi32(b8);
+        sum = _mm512_add_epi32(sum, _mm512_mullo_epi32(a32, b32));
+    }
+    return _mm512_reduce_add_epi32(sum);
+}
+#endif
+
+#if defined(USE_SSE41)
+static DISTFUNC<int> InnerProductU8SIMD16Ext = InnerProductU8SIMD16ExtSSE41;
+
+static int
+InnerProductDistanceU8SIMD16Ext(const void *pVect1v, const void *pVect2v, const void *qty_ptr) {
+    return -InnerProductU8SIMD16Ext(pVect1v, pVect2v, qty_ptr);
+}
+
+static int
+InnerProductDistanceU8SIMD16ExtResiduals(const void *pVect1v, const void *pVect2v, const void *qty_ptr) {
+    size_t qty = *((size_t *) qty_ptr);
+    size_t qty16 = qty >> 4 << 4;
+    int res = InnerProductU8SIMD16Ext(pVect1v, pVect2v, &qty16);
+
+    const unsigned char *pVect1 = (const unsigned char *) pVect1v + qty16;
+    const unsigned char *pVect2 = (const unsigned char *) pVect2v + qty16;
+    size_t qty_left = qty - qty16;
+    int res_tail = InnerProductU8(pVect1, pVect2, &qty_left);
+    return -(res + res_tail);
+}
+#endif
+
+class InnerProductSpaceU8 : public SpaceInterface<int> {
+    DISTFUNC<int> fstdistfunc_;
+    size_t data_size_;
+    size_t dim_;
+
+ public:
+    InnerProductSpaceU8(size_t dim) {
+        fstdistfunc_ = InnerProductDistanceU8;
+#if defined(USE_SSE41)
+#if defined(USE_AVX512)
+        if (AVX512Capable())
+            InnerProductU8SIMD16Ext = InnerProductU8SIMD16ExtAVX512;
+        else if (AVX2Capable())
+            InnerProductU8SIMD16Ext = InnerProductU8SIMD16ExtAVX2;
+#elif defined(USE_AVX2)
+        if (AVX2Capable())
+            InnerProductU8SIMD16Ext = InnerProductU8SIMD16ExtAVX2;
+#endif
+        if (dim % 16 == 0)
+            fstdistfunc_ = InnerProductDistanceU8SIMD16Ext;
+        else if (dim > 16)
+            fstdistfunc_ = InnerProductDistanceU8SIMD16ExtResiduals;
+#endif
+        dim_ = dim;
+        data_size_ = dim * sizeof(unsigned char);
+    }
+
+    size_t get_data_size() {
+        return data_size_;
+    }
+
+    DISTFUNC<int> get_dist_func() {
+        return fstdistfunc_;
+    }
+
+    void *get_dist_func_param() {
+        return &dim_;
+    }
+
+    ~InnerProductSpaceU8() {}
+};
+
+// Signed int8_t mirror of InnerProductSpaceU8 above -- identical structure,
+// sign-extending widen instructions (PMOVSXBD) instead of zero-extending.
+static int
+InnerProductInt8(const void *__restrict pVect1v, const void *__restrict pVect2v, const void *__restrict qty_ptr) {
+    const int8_t *pVect1 = (const int8_t *) pVect1v;
+    const int8_t *pVect2 = (const int8_t *) pVect2v;
+    size_t qty = *((size_t *) qty_ptr);
+
+    int res = 0;
+    for (size_t i = 0; i < qty; i++) {
+        res += (int) pVect1[i] * (int) pVect2[i];
+    }
+    return res;
+}
+
+static int
+InnerProductDistanceInt8(const void *pVect1v, const void *pVect2v, const void *qty_ptr) {
+    return -InnerProductInt8(pVect1v, pVect2v, qty_ptr);
+}
+
+#if defined(USE_SSE41)
+static int
+InnerProductInt8SIMD16ExtSSE41(const void *__restrict pVect1v, const void *__restrict pVect2v,
+        const void *__restrict qty_ptr) {
+    const int8_t *pVect1 = (const int8_t *) pVect1v;
+    const int8_t *pVect2 = (const int8_t *) pVect2v;
+    size_t qty = *((size_t *) qty_ptr);
+    size_t qty16 = qty >> 4;
+
+    __m128i sum = _mm_setzero_si128();
+    for (size_t i = 0; i < qty16; i++) {
+        for (int j = 0; j < 4; j++) {
+            int32_t a4, b4;
+            std::memcpy(&a4, pVect1, 4);
+            std::memcpy(&b4, pVect2, 4);
+            pVect1 += 4;
+            pVect2 += 4;
+            __m128i a32 = _mm_cvtepi8_epi32(_mm_cvtsi32_si128(a4));
+            __m128i b32 = _mm_cvtepi8_epi32(_mm_cvtsi32_si128(b4));
+            sum = _mm_add_epi32(sum, _mm_mullo_epi32(a32, b32));
+        }
+    }
+
+    int32_t PORTABLE_ALIGN32 tmp[4];
+    _mm_store_si128((__m128i *) tmp, sum);
+    return tmp[0] + tmp[1] + tmp[2] + tmp[3];
+}
+#endif
+
+#if defined(USE_AVX2)
+static int
+InnerProductInt8SIMD16ExtAVX2(const void *__restrict pVect1v, const void *__restrict pVect2v,
+        const void *__restrict qty_ptr) {
+    const int8_t *pVect1 = (const int8_t *) pVect1v;
