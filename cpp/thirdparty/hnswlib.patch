+// SIMD tiers for L2SpaceI (unsigned char / uint8 data). All widen bytes to
+// 32-bit lanes (via PMOVZXBD-family instructions) before subtracting and
+// squaring, rather than doing arithmetic in 8/16-bit lanes -- a uint8 diff
+// is at most 255, so its square (up to 65025) already doesn't fit in
+// int16, let alone the diff-of-diffs tricks some SIMD dot-product code
+// uses. Widening to int32 first sidesteps that entirely: everything below
+// is exact, not an approximation.
+//
+// Every tier (SSE41/AVX2/AVX512) processes a 16-byte outer chunk per call,
+// like the float kernels above process a 16-float chunk regardless of
+// which ISA backs L2SqrSIMD16Ext -- SSE41 covers it via 4 widen-4 substeps,
+// AVX2 via 2 widen-8 substeps, AVX512 via 1 widen-16 step. Keeping the
+// outer contract uniform lets all three share one residual wrapper
+// (L2SqrU8SIMD16ExtResiduals), exactly mirroring L2SqrSIMD16ExtResiduals.
+//
+// PMOVZXBD (the widening instruction) needs SSE4.1, not baseline SSE/SSE2;
+// its 256-bit form needs true AVX2, not just AVX1 -- see USE_SSE41/
+// USE_AVX2 in hnswlib.h for why USE_SSE/USE_AVX alone aren't checked here.
+#if defined(USE_SSE41)
+static int
+L2SqrU8SIMD16ExtSSE41(const void *__restrict pVect1v, const void *__restrict pVect2v,
+        const void *__restrict qty_ptr) {
+    const unsigned char *pVect1 = (const unsigned char *) pVect1v;
+    const unsigned char *pVect2 = (const unsigned char *) pVect2v;
+    size_t qty = *((size_t *) qty_ptr);
+    size_t qty16 = qty >> 4;
+
+    __m128i sum = _mm_setzero_si128();
+    for (size_t i = 0; i < qty16; i++) {
+        for (int j = 0; j < 4; j++) {  // 4 substeps x 4 bytes = 16 bytes/iter
+            int32_t a4, b4;
+            std::memcpy(&a4, pVect1, 4);
+            std::memcpy(&b4, pVect2, 4);
+            pVect1 += 4;
+            pVect2 += 4;
+            __m128i a32 = _mm_cvtepu8_epi32(_mm_cvtsi32_si128(a4));
+            __m128i b32 = _mm_cvtepu8_epi32(_mm_cvtsi32_si128(b4));
+            __m128i diff = _mm_sub_epi32(a32, b32);
+            sum = _mm_add_epi32(sum, _mm_mullo_epi32(diff, diff));
+        }
+    }
+
+    int32_t PORTABLE_ALIGN32 tmp[4];
+    _mm_store_si128((__m128i *) tmp, sum);
+    return tmp[0] + tmp[1] + tmp[2] + tmp[3];
+}
+#endif
+
+#if defined(USE_AVX2)
+static int
+L2SqrU8SIMD16ExtAVX2(const void *__restrict pVect1v, const void *__restrict pVect2v,
+        const void *__restrict qty_ptr) {
+    const unsigned char *pVect1 = (const unsigned char *) pVect1v;
+    const unsigned char *pVect2 = (const unsigned char *) pVect2v;
+    size_t qty = *((size_t *) qty_ptr);
+    size_t qty16 = qty >> 4;
+
+    __m256i sum = _mm256_setzero_si256();
+    for (size_t i = 0; i < qty16; i++) {
+        for (int j = 0; j < 2; j++) {  // 2 substeps x 8 bytes = 16 bytes/iter
+            __m128i a8 = _mm_loadl_epi64((const __m128i *) pVect1);
+            __m128i b8 = _mm_loadl_epi64((const __m128i *) pVect2);
+            pVect1 += 8;
+            pVect2 += 8;
+            __m256i a32 = _mm256_cvtepu8_epi32(a8);
+            __m256i b32 = _mm256_cvtepu8_epi32(b8);
+            __m256i diff = _mm256_sub_epi32(a32, b32);
+            sum = _mm256_add_epi32(sum, _mm256_mullo_epi32(diff, diff));
+        }
+    }
+
+    int32_t PORTABLE_ALIGN32 tmp[8];
+    _mm256_storeu_si256((__m256i *) tmp, sum);
+    return tmp[0] + tmp[1] + tmp[2] + tmp[3] + tmp[4] + tmp[5] + tmp[6] + tmp[7];
+}
+#endif
+
+#if defined(USE_AVX512)
+static int
+L2SqrU8SIMD16ExtAVX512(const void *__restrict pVect1v, const void *__restrict pVect2v,
+        const void *__restrict qty_ptr) {
+    const unsigned char *pVect1 = (const unsigned char *) pVect1v;
