+// L2Sqr* kernels above already use, just fed converted lanes instead of
+// loading float lanes directly. Both tiers keep the same 16-element outer
+// chunk contract as the uint8/int8 kernels above, for the same reason
+// (one shared residual wrapper): the F16C-only tier covers it via 2
+// widen-8 substeps (_mm256_cvtph_ps, needs F16C+AVX but not AVX512), the
+// AVX512 tier via 1 widen-16 step (_mm512_cvtph_ps, AVX512F baseline --
+// unlike the 128/256-bit forms, the 512-bit half<->float conversion
+// doesn't need the separate F16C CPUID bit).
+static float
+L2SqrHalf(const void *pVect1v, const void *pVect2v, const void *qty_ptr) {
+    const uint16_t *pVect1 = (const uint16_t *) pVect1v;
+    const uint16_t *pVect2 = (const uint16_t *) pVect2v;
+    size_t qty = *((size_t *) qty_ptr);
+
+    float res = 0;
+    for (size_t i = 0; i < qty; i++) {
+        float t = HalfToFloat(pVect1[i]) - HalfToFloat(pVect2[i]);
+        res += t * t;
+    }
+    return res;
+}
+
+#if defined(USE_F16C)
+static float
+L2SqrHalfSIMD16ExtF16C(const void *pVect1v, const void *pVect2v, const void *qty_ptr) {
+    const uint16_t *pVect1 = (const uint16_t *) pVect1v;
+    const uint16_t *pVect2 = (const uint16_t *) pVect2v;
+    size_t qty = *((size_t *) qty_ptr);
+    size_t qty16 = qty >> 4;
+    float PORTABLE_ALIGN32 TmpRes[8];
+
+    __m256 sum = _mm256_set1_ps(0);
+    for (size_t i = 0; i < qty16; i++) {
+        for (int j = 0; j < 2; j++) {  // 2 substeps x 8 halfs = 16 halfs/iter
+            __m128i h1 = _mm_loadu_si128((const __m128i *) pVect1);
+            __m128i h2 = _mm_loadu_si128((const __m128i *) pVect2);
+            pVect1 += 8;
+            pVect2 += 8;
+            __m256 v1 = _mm256_cvtph_ps(h1);
+            __m256 v2 = _mm256_cvtph_ps(h2);
+            __m256 diff = _mm256_sub_ps(v1, v2);
+            sum = _mm256_add_ps(sum, _mm256_mul_ps(diff, diff));
+        }
+    }
+
+    _mm256_store_ps(TmpRes, sum);
+    return TmpRes[0] + TmpRes[1] + TmpRes[2] + TmpRes[3] + TmpRes[4] + TmpRes[5] + TmpRes[6] + TmpRes[7];
+}
+#endif
+
+#if defined(USE_AVX512) && defined(__F16C__)
+static float
+L2SqrHalfSIMD16ExtAVX512(const void *pVect1v, const void *pVect2v, const void *qty_ptr) {
+    const uint16_t *pVect1 = (const uint16_t *) pVect1v;
+    const uint16_t *pVect2 = (const uint16_t *) pVect2v;
+    size_t qty = *((size_t *) qty_ptr);
+    size_t qty16 = qty >> 4;
+
+    __m512 sum = _mm512_set1_ps(0);
+    for (size_t i = 0; i < qty16; i++) {
+        __m256i h1 = _mm256_loadu_si256((const __m256i *) pVect1);
+        __m256i h2 = _mm256_loadu_si256((const __m256i *) pVect2);
+        pVect1 += 16;
+        pVect2 += 16;
+        __m512 v1 = _mm512_cvtph_ps(h1);
+        __m512 v2 = _mm512_cvtph_ps(h2);
+        __m512 diff = _mm512_sub_ps(v1, v2);
+        sum = _mm512_add_ps(sum, _mm512_mul_ps(diff, diff));
+    }
+    return _mm512_reduce_add_ps(sum);
+}
+#endif
+
+#if defined(USE_F16C)
+// Whenever the AVX512 tier above is compiled in (USE_AVX512 && __F16C__),
+// USE_F16C is necessarily defined too (USE_AVX512 implies USE_AVX, and
+// combined with __F16C__ that's USE_F16C's exact condition) -- so this is
+// always a valid, safe compile-time default, same reasoning as
+// L2SqrU8SIMD16Ext's SSE41 default above.
+static DISTFUNC<float> L2SqrHalfSIMD16Ext = L2SqrHalfSIMD16ExtF16C;
+
+static float
+L2SqrHalfSIMD16ExtResiduals(const void *pVect1v, const void *pVect2v, const void *qty_ptr) {
+    size_t qty = *((size_t *) qty_ptr);
+    size_t qty16 = qty >> 4 << 4;
+    float res = L2SqrHalfSIMD16Ext(pVect1v, pVect2v, &qty16);
+
+    const uint16_t *pVect1 = (const uint16_t *) pVect1v + qty16;
+    const uint16_t *pVect2 = (const uint16_t *) pVect2v + qty16;
+    size_t qty_left = qty - qty16;
+    float res_tail = L2SqrHalf(pVect1, pVect2, &qty_left);
+    return res + res_tail;
+}
+#endif
+
+class L2SpaceHalf : public SpaceInterface<float> {
+    DISTFUNC<float> fstdistfunc_;
+    size_t data_size_;
+    size_t dim_;
+
+ public:
+    L2SpaceHalf(size_t dim) {
+        fstdistfunc_ = L2SqrHalf;
+#if defined(USE_F16C)
+#if defined(USE_AVX512) && defined(__F16C__)
+        if (AVX512Capable() && F16CCapable())
+            L2SqrHalfSIMD16Ext = L2SqrHalfSIMD16ExtAVX512;
+        else if (F16CCapable())
+            L2SqrHalfSIMD16Ext = L2SqrHalfSIMD16ExtF16C;
+#else
+        if (F16CCapable())
+            L2SqrHalfSIMD16Ext = L2SqrHalfSIMD16ExtF16C;
+#endif
+        if (dim % 16 == 0)
+            fstdistfunc_ = L2SqrHalfSIMD16Ext;
+        else if (dim > 16)
+            fstdistfunc_ = L2SqrHalfSIMD16ExtResiduals;
+#endif
+        dim_ = dim;
+        data_size_ = dim * sizeof(uint16_t);
+    }
+
+    size_t get_data_size() {
+        return data_size_;
+    }
+
+    DISTFUNC<float> get_dist_func() {
+        return fstdistfunc_;
+    }
+
+    void *get_dist_func_param() {
+        return &dim_;
+    }
+
+    ~L2SpaceHalf() {}
+};
+
 }  // namespace hnswlib
diff --git a/tests/cpp/dtype_space_test.cpp b/tests/cpp/dtype_space_test.cpp
new file mode 100644
index 0000000..5d348dd
--- /dev/null
+++ b/tests/cpp/dtype_space_test.cpp
@@ -0,0 +1,280 @@
+// Correctness test for the uint8/int8/float16 spaces added on top of
+// upstream hnswlib (L2SpaceI's new SIMD tiers, L2SpaceInt8, L2SpaceHalf,
+// InnerProductSpaceU8, InnerProductSpaceInt8, InnerProductSpaceHalf -- see
+// space_l2.h/space_ip.h). Two levels:
+//   1. Every compiled-in SIMD tier's raw distance function, called
+//      directly, must agree with the plain scalar reference across many
+//      dims (including ones not a multiple of the SIMD chunk width, to
+//      exercise the residual path) and randomized data spanning each
+//      type's full value range.
+//   2. Each new Space class, used exactly as HierarchicalNSW would (build
+//      a real graph, insert, search), must actually work end to end and
+//      recall a point queried with its own vector.
+//
+// Which SIMD tiers get exercised depends on how this file itself is
+// compiled (USE_SSE41/USE_AVX2/USE_F16C/USE_AVX512, set from hnswlib.h
+// based on the -m<isa> flags passed) -- run this binary built under a few
+// different flag combinations to cover every tier.
+
+#include "../../hnswlib/hnswlib.h"
+
+#include <algorithm>
+#include <cassert>
+#include <cmath>
+#include <cstdint>
+#include <iostream>
+#include <random>
+#include <vector>
+
+namespace {
+
+std::mt19937 rng(12345);
+
+std::vector<unsigned char> RandomU8(size_t n) {
+    std::uniform_int_distribution<int> dist(0, 255);
+    std::vector<unsigned char> v(n);
+    for (auto &x : v) x = static_cast<unsigned char>(dist(rng));
+    return v;
+}
+
+std::vector<int8_t> RandomInt8(size_t n) {
+    std::uniform_int_distribution<int> dist(-128, 127);
+    std::vector<int8_t> v(n);
+    for (auto &x : v) x = static_cast<int8_t>(dist(rng));
+    return v;
+}
+
+std::vector<uint16_t> RandomHalf(size_t n) {
+    std::uniform_real_distribution<float> dist(-10.0f, 10.0f);
+    std::vector<uint16_t> v(n);
+    for (auto &x : v) x = hnswlib::FloatToHalf(dist(rng));
+    return v;
+}
+
+std::vector<float> RandomFloat(size_t n) {
+    std::uniform_real_distribution<float> dist(-10.0f, 10.0f);
+    std::vector<float> v(n);
+    for (auto &x : v) x = dist(rng);
+    return v;
+}
+
+const size_t kDims[] = {1, 2, 3, 4, 7, 8, 15, 16, 17, 31, 32, 33, 100, 129, 257};
+
+// ---- Level 1: SIMD tier vs scalar reference, per compiled-in tier ----
+
+void TestU8L2() {
+    for (size_t dim : kDims) {
+        auto a = RandomU8(dim);
+        auto b = RandomU8(dim);
+        int expected = hnswlib::L2SqrI(a.data(), b.data(), &dim);
+
+#if defined(USE_SSE41)
+        int got_sse41 = hnswlib::L2SqrU8SIMD16ExtSSE41(a.data(), b.data(), &dim);
+        if (dim % 16 == 0) assert(got_sse41 == expected);
+#endif
+#if defined(USE_AVX2)
+        if (dim >= 16) {
+            int got_avx2 = hnswlib::L2SqrU8SIMD16ExtAVX2(a.data(), b.data(), &dim);
+            if (dim % 16 == 0) assert(got_avx2 == expected);
+        }
+#endif
+#if defined(USE_SSE41)
+        // Residual path (the one L2SpaceI's constructor actually picks
+        // for non-multiple-of-16 dims) must match regardless of dim.
+        int got_residual = hnswlib::L2SqrU8SIMD16ExtResiduals(a.data(), b.data(), &dim);
+        assert(got_residual == expected);
+#endif
+    }
+    std::cout << "TestU8L2 ok\n";
+}
+
+void TestInt8L2() {
+    for (size_t dim : kDims) {
+        auto a = RandomInt8(dim);
+        auto b = RandomInt8(dim);
+        int expected = hnswlib::L2SqrInt8(a.data(), b.data(), &dim);
+
+#if defined(USE_SSE41)
+        int got_residual = hnswlib::L2SqrInt8SIMD16ExtResiduals(a.data(), b.data(), &dim);
+        assert(got_residual == expected);
+        if (dim % 16 == 0) {
+            int got_sse41 = hnswlib::L2SqrInt8SIMD16ExtSSE41(a.data(), b.data(), &dim);
+            assert(got_sse41 == expected);
+        }
+#endif
+#if defined(USE_AVX2)
+        if (dim % 16 == 0) {
+            int got_avx2 = hnswlib::L2SqrInt8SIMD16ExtAVX2(a.data(), b.data(), &dim);
+            assert(got_avx2 == expected);
+        }
+#endif
+    }
+    std::cout << "TestInt8L2 ok\n";
+}
+
+void TestHalfL2() {
+    for (size_t dim : kDims) {
+        auto a = RandomHalf(dim);
+        auto b = RandomHalf(dim);
+        float expected = hnswlib::L2SqrHalf(a.data(), b.data(), &dim);
+
+#if defined(USE_F16C)
+        float got_residual = hnswlib::L2SqrHalfSIMD16ExtResiduals(a.data(), b.data(), &dim);
+        // Relative tolerance: half itself only carries ~3 decimal digits,
+        // and the SIMD/scalar paths may sum in a different order.
+        float tol = std::max(1e-3f, std::fabs(expected) * 1e-2f);
+        assert(std::fabs(got_residual - expected) <= tol);
+        if (dim % 16 == 0) {
+            float got_f16c = hnswlib::L2SqrHalfSIMD16ExtF16C(a.data(), b.data(), &dim);
+            assert(std::fabs(got_f16c - expected) <= tol);
+        }
+#endif
+    }
+    std::cout << "TestHalfL2 ok\n";
+}
+
+void TestU8InnerProduct() {
+    for (size_t dim : kDims) {
+        auto a = RandomU8(dim);
+        auto b = RandomU8(dim);
+        int expected = -hnswlib::InnerProductU8(a.data(), b.data(), &dim);
+
+#if defined(USE_SSE41)
+        int got_residual = hnswlib::InnerProductDistanceU8SIMD16ExtResiduals(a.data(), b.data(), &dim);
+        assert(got_residual == expected);
+#endif
+    }
+    std::cout << "TestU8InnerProduct ok\n";
+}
+
+void TestInt8InnerProduct() {
+    for (size_t dim : kDims) {
+        auto a = RandomInt8(dim);
+        auto b = RandomInt8(dim);
+        int expected = -hnswlib::InnerProductInt8(a.data(), b.data(), &dim);
+
+#if defined(USE_SSE41)
+        int got_residual = hnswlib::InnerProductDistanceInt8SIMD16ExtResiduals(a.data(), b.data(), &dim);
+        assert(got_residual == expected);
+#endif
+    }
+    std::cout << "TestInt8InnerProduct ok\n";
+}
+
+void TestHalfInnerProduct() {
+    for (size_t dim : kDims) {
+        auto a = RandomHalf(dim);
+        auto b = RandomHalf(dim);
+        float expected = 1.0f - hnswlib::InnerProductHalf(a.data(), b.data(), &dim);
+
+#if defined(USE_F16C)
+        float got_residual = hnswlib::InnerProductDistanceHalfSIMD16ExtResiduals(a.data(), b.data(), &dim);
+        float tol = std::max(1e-3f, std::fabs(expected) * 1e-2f);
+        assert(std::fabs(got_residual - expected) <= tol);
+#endif
+    }
+    std::cout << "TestHalfInnerProduct ok\n";
+}
+
+// ---- Level 2: full HierarchicalNSW build + search, per new Space ----
+// (inline per-space below in main(), rather than templated -- the new
+// Space classes don't share a common dist_t, and this is a small enough
+// amount of repetition to just write out, matching hnswlib's own test
+// style elsewhere in this directory.)
+
+}  // namespace
+
+int main() {
+    std::cout << "Compiled-in SIMD tiers for this run:"
+#if defined(USE_SSE41)
+              << " SSE41"
+#endif
+#if defined(USE_AVX2)
+              << " AVX2"
+#endif
+#if defined(USE_F16C)
+              << " F16C"
+#endif
+#if defined(USE_AVX512)
+              << " AVX512"
+#endif
+              << "\n";
+
+    TestU8L2();
+    TestInt8L2();
+    TestHalfL2();
+    TestU8InnerProduct();
+    TestInt8InnerProduct();
+    TestHalfInnerProduct();
+
+    // SpaceInterface<...>::type_dist_t doesn't exist on the base class in
+    // this hnswlib version, so pass the dist_t explicitly per space
+    // instead of relying on a member typedef.
+    {
+        hnswlib::L2SpaceI space(100);
+        hnswlib::HierarchicalNSW<int> index(&space, 200, 16, 100);
+        std::vector<std::vector<unsigned char>> data;
+        for (size_t i = 0; i < 200; i++) {
+            data.push_back(RandomU8(100));
+            index.addPoint(data.back().data(), i);
+        }
+        index.setEf(50);
+        size_t misses = 0;
+        for (size_t i = 0; i < 200; i++) {
+            if (index.searchKnn(data[i].data(), 1).top().second != i) misses++;
+        }
+        std::cout << "L2SpaceI graph self-recall misses: " << misses << "/200\n";
+        assert(misses <= 10);
+    }
+    {
+        hnswlib::L2SpaceInt8 space(100);
+        hnswlib::HierarchicalNSW<int> index(&space, 200, 16, 100);
+        std::vector<std::vector<int8_t>> data;
+        for (size_t i = 0; i < 200; i++) {
+            data.push_back(RandomInt8(100));
+            index.addPoint(data.back().data(), i);
+        }
+        index.setEf(50);
+        size_t misses = 0;
+        for (size_t i = 0; i < 200; i++) {
+            if (index.searchKnn(data[i].data(), 1).top().second != i) misses++;
+        }
+        std::cout << "L2SpaceInt8 graph self-recall misses: " << misses << "/200\n";
+        assert(misses <= 10);
+    }
+    {
+        hnswlib::L2SpaceHalf space(100);
+        hnswlib::HierarchicalNSW<float> index(&space, 200, 16, 100);
+        std::vector<std::vector<uint16_t>> data;
+        for (size_t i = 0; i < 200; i++) {
+            data.push_back(RandomHalf(100));
+            index.addPoint(data.back().data(), i);
+        }
+        index.setEf(50);
+        size_t misses = 0;
+        for (size_t i = 0; i < 200; i++) {
+            if (index.searchKnn(data[i].data(), 1).top().second != i) misses++;
+        }
+        std::cout << "L2SpaceHalf graph self-recall misses: " << misses << "/200\n";
+        assert(misses <= 10);
+    }
+    {
+        hnswlib::InnerProductSpaceHalf space(100);
+        hnswlib::HierarchicalNSW<float> index(&space, 200, 16, 100);
+        std::vector<std::vector<uint16_t>> data;
+        for (size_t i = 0; i < 200; i++) {
+            data.push_back(RandomHalf(100));
+            index.addPoint(data.back().data(), i);
+        }
+        index.setEf(50);
+        size_t misses = 0;
+        for (size_t i = 0; i < 200; i++) {
+            if (index.searchKnn(data[i].data(), 1).top().second != i) misses++;
+        }
+        std::cout << "InnerProductSpaceHalf graph self-recall misses: " << misses << "/200\n";
+        assert(misses <= 10);
+    }
+
+    std::cout << "ALL DTYPE SPACE TESTS PASSED\n";
+    return 0;
+}
