+class InnerProductSpaceHalf : public SpaceInterface<float> {
+    DISTFUNC<float> fstdistfunc_;
+    size_t data_size_;
+    size_t dim_;
+
+ public:
+    InnerProductSpaceHalf(size_t dim) {
+        fstdistfunc_ = InnerProductDistanceHalf;
+#if defined(USE_F16C)
+#if defined(USE_AVX512) && defined(__F16C__)
+        if (AVX512Capable() && F16CCapable())
+            InnerProductHalfSIMD16Ext = InnerProductHalfSIMD16ExtAVX512;
+        else if (F16CCapable())
