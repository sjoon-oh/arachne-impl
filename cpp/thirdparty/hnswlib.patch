+#else
+        if (F16CCapable())
+            InnerProductHalfSIMD16Ext = InnerProductHalfSIMD16ExtF16C;
+#endif
+        if (dim % 16 == 0)
+            fstdistfunc_ = InnerProductDistanceHalfSIMD16Ext;
+        else if (dim > 16)
+            fstdistfunc_ = InnerProductDistanceHalfSIMD16ExtResiduals;
+#endif
+        dim_ = dim;
+        data_size_ = dim * sizeof(uint16_t);
+    }
